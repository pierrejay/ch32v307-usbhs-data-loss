 RING_BUFF_COMM  RingBuffer_Comm;
 __attribute__ ((aligned(4))) uint8_t Data_Buffer[DEF_RING_BUFFER_SIZE];
 
+/* Toggle policies: a data endpoint's transfer is taken when the SIE has flipped its toggle,
+ * read once the SIE is free, on every transfer interrupt whatever INT_ST shows: a late entry
+ * can find INT_ST already showing a later token, for this endpoint or another one. */
+static uint8_t EP1_Rx_Tog, EP3_Rx_Tog, EP1_Tx_Tog, EP4_Tx_Tog;
+/* For a debug probe: entries that found two endpoints flipped, which one pending flag should not allow. */
+volatile uint32_t Toggle_Two_Flipped;
+
+static void Toggle_Check( void )
+{
+    uint32_t n = 0;
+    uint8_t  tog, flipped = 0;
+    uint16_t len, i;
+
+    while( ( ( USBHSD->MIS_ST & USBHS_UMS_SIE_FREE ) == 0 ) && ( n < 2000 ) )
+    {
+        n++;
+    }
+    tog = USBHSD->UEP2_TX_CTRL & USBHS_UEP_T_TOG_MASK;
+    if( tog != EP1_Tx_Tog )
+    {
+        EP1_Tx_Tog = tog;
+        flipped++;
+        USBHSD->UEP2_TX_CTRL = (USBHSD->UEP2_TX_CTRL & ~USBHS_UEP_T_RES_MASK) | USBHS_UEP_T_RES_NAK;
+        USBHS_Endp_Busy[ DEF_UEP2 ] &= ~DEF_UEP_BUSY;
+    }
+    tog = USBHSD->UEP4_TX_CTRL & USBHS_UEP_T_TOG_MASK;
+    if( tog != EP4_Tx_Tog )
+    {
+        EP4_Tx_Tog = tog;
+        flipped++;
+        USBHSD->UEP4_TX_CTRL = (USBHSD->UEP4_TX_CTRL & ~USBHS_UEP_T_RES_MASK) | USBHS_UEP_T_RES_NAK;
+        USBHS_Endp_Busy[ DEF_UEP4 ] &= ~DEF_UEP_BUSY;
+        USBHSD->UEP3_RX_CTRL = ((USBHSD->UEP3_RX_CTRL) & ~USBHS_UEP_R_RES_MASK) | USBHS_UEP_R_RES_ACK;
+    }
+    tog = USBHSD->UEP1_RX_CTRL & USBHS_UEP_R_TOG_MASK;
+    if( tog != EP1_Rx_Tog )
+    {
+        EP1_Rx_Tog = tog;
+        flipped++;
+        RingBuffer_Comm.PackLen[RingBuffer_Comm.LoadPtr] = USBHSD->RX_LEN;
+        RingBuffer_Comm.LoadPtr ++;
+        if(RingBuffer_Comm.LoadPtr == DEF_Ring_Buffer_Max_Blks)
+        {
+            RingBuffer_Comm.LoadPtr = 0;
+        }
+        USBHSD->UEP1_RX_DMA = (uint32_t)(&Data_Buffer[(RingBuffer_Comm.LoadPtr) * DEF_USBD_HS_PACK_SIZE]);
+        RingBuffer_Comm.RemainPack ++;
+        if(RingBuffer_Comm.RemainPack >= DEF_Ring_Buffer_Max_Blks-DEF_RING_BUFFER_REMINE)
+        {
+            USBHSD->UEP1_RX_CTRL = ((USBHSD->UEP1_RX_CTRL) & ~USBHS_UEP_R_RES_MASK) | USBHS_UEP_R_RES_NAK;
+            RingBuffer_Comm.StopFlag = 1;
+        }
+    }
+    tog = USBHSD->UEP3_RX_CTRL & USBHS_UEP_R_TOG_MASK;
+    if( tog != EP3_Rx_Tog )
+    {
+        EP3_Rx_Tog = tog;
+        flipped++;
+        len = (uint16_t)(USBHSD->RX_LEN);
+        USBHSD->UEP3_RX_CTRL = ((USBHSD->UEP3_RX_CTRL) & ~USBHS_UEP_R_RES_MASK) | USBHS_UEP_R_RES_NAK;
+        for(i=0; i<len; i++)
+        {
+            USBHS_EP4_Tx_Buf[i] = ~USBHS_EP3_Rx_Buf[i];
+        }
+        USBHSD->UEP4_TX_LEN = len;
+        USBHSD->UEP4_TX_CTRL = (USBHSD->UEP4_TX_CTRL & ~USBHS_UEP_T_RES_MASK) | USBHS_UEP_T_RES_ACK;
+    }
+    if( flipped > 1 )
+    {
+        Toggle_Two_Flipped++;
+    }
+}
+
