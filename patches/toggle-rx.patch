+static void EP1_Toggle_Check( void )
+{
+    uint32_t n = 0;
+    uint8_t  tog;
+    uint8_t  *slot;
+
+    /* A late entry can show a later token in INT_ST, and TOG_OK is not final when the
+     * flag rises. With auto toggle, the SIE flips the toggle on each packet it accepts
+     * (OUT) or the host acknowledges (IN); a retransmitted OUT packet (wrong toggle) is
+     * acknowledged and leaves it as it is. So read it once the SIE is free, on every
+     * transfer entry, whatever INT_ST shows. */
+    while( ( ( USBHSD->MIS_ST & USBHS_UMS_SIE_FREE ) == 0 ) && ( n < 2000 ) )
+    {
+        n++;
+    }
+    tog = USBHSD->UEP1_RX_CTRL & USBHS_UEP_R_TOG_MASK;
+    if( tog == EP1_Rx_Tog )
+    {
+        return;
+    }
+    EP1_Rx_Tog = tog;
+    slot = &Data_Buffer[ ( RingBuffer_Comm.LoadPtr ) * DEF_USBD_HS_PACK_SIZE ];
+    RingBuffer_Comm.PackLen[RingBuffer_Comm.LoadPtr] = USBHSD->RX_LEN;
+    /* Duplicate test (runner.py --duplicate): after a packet starting with DUPTEST!,
+     * expect the other toggle, so that the host's next packet looks like a
+     * retransmission, to be acknowledged and dropped. */
+    if( memcmp( slot, "DUPTEST!", 8 ) == 0 )
+    {
+        USBHSD->UEP1_RX_CTRL ^= USBHS_UEP_R_TOG_DATA1;
+        EP1_Rx_Tog ^= USBHS_UEP_R_TOG_DATA1;
+    }
+    RingBuffer_Comm.LoadPtr ++;
+    if(RingBuffer_Comm.LoadPtr == DEF_Ring_Buffer_Max_Blks)
+    {
+        RingBuffer_Comm.LoadPtr = 0;
+    }
+    USBHSD->UEP1_RX_DMA = (uint32_t)(&Data_Buffer[(RingBuffer_Comm.LoadPtr) * DEF_USBD_HS_PACK_SIZE]);
+    RingBuffer_Comm.RemainPack ++;
+    if(RingBuffer_Comm.RemainPack >= DEF_Ring_Buffer_Max_Blks-DEF_RING_BUFFER_REMINE)
+    {
+        USBHSD->UEP1_RX_CTRL = ((USBHSD->UEP1_RX_CTRL) & ~USBHS_UEP_R_RES_MASK) | USBHS_UEP_R_RES_NAK;
+        RingBuffer_Comm.StopFlag = 1;
+    }
+}
